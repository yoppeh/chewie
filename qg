#!/bin/bash
#
# qg 
#
# script that uses chewie to implement a git-specific chat bot.
#

# API selection: CHEWIE_API, then CHEWIE_AI_PROVIDER, then ollama. "groq" uses
# Groq's OpenAI-compatible endpoint with the key from GROQ_API_KEY.
CHEWIE_API="${CHEWIE_API:-${CHEWIE_AI_PROVIDER:-ollama}}"
case "$CHEWIE_API" in
openai)
    QG_MODEL="gpt-3.5-turbo"
    CHEWIE_AIP=(aip=openai)
    ;;
groq)
    QG_MODEL="llama3-8b-8192"
    CHEWIE_AIP=(aip=openai aih=https://api.groq.com/openai)
    export OPENAI_API_KEY="${GROQ_API_KEY:-$OPENAI_API_KEY}"
    ;;
*)
    CHEWIE_API="ollama"
    QG_MODEL="codellama:7b-instruct"
    CHEWIE_AIP=(aip=ollama)
    ;;
esac

QG_CONTEXT_PATH=~/.cache/chewie
QG_CONTEXT=$QG_CONTEXT_PATH/qg-context.json

if [ "$1" == "-h" ] ; then
    echo "Usage: qg [options]"
    echo "Options:"
    echo "  -h  Display this help message."
    echo "  -s  Setup (or reset) qg."
    exit 0
fi

if [ "$1" == "-s" ] ; then
    echo "Setting up qg... "
    echo "Using API \"$CHEWIE_API\""
    echo "Using model \"$QG_MODEL\""
    echo "Using context file \"$QG_CONTEXT\""
    mkdir -p $QG_CONTEXT_PATH
    chewie "${CHEWIE_AIP[@]}" r u ctx="$QG_CONTEXT" > /dev/null
    chewie "${CHEWIE_AIP[@]}" u ctx="$QG_CONTEXT" mdl="$QG_MODEL" sys="You are an intelligent assistant helping me use git on Linux. All of your responses should be in the context of using git on Linux. If you do not know the answer to a question, just say \"I don't know\"." > /dev/null
    echo "done!"
    exit 0
fi

echo "$*" | chewie "${CHEWIE_AIP[@]}" ctx="$QG_CONTEXT" mdl="$QG_MODEL"
